<?xml version="1.0"?>
<package format="2">
  <name>farlio_odometry</name>
  <version>0.1.0</version>
  <description>
    ROS 1 (Noetic) full port of FAR-LIO: LiDAR odometry (CPU) and the
    100 Hz state-estimation EKF (2D/3D x Kinematic/NonHolonomic/SingleTrack),
    multi-LiDAR merger, map service and TSL diagnostics.
  </description>
  <maintainer email="komasa@example.com">komasa</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>yaml-cpp</depend>
  <depend>farlio_msgs</depend>
  <depend>livox_ros_driver</depend>
  <depend>message_runtime</depend>
  <depend>boost</depend>
  <depend>eigen</depend>
  <depend>libtbb-dev</depend>

  <export/>
</package>
